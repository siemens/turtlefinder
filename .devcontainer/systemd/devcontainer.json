{
    "name": "turtlefinder (systemd and docker-in-docker)",
    "portsAttributes": {
        "6060": {
            "label": "turtlefinder package documentation",
            "onAutoForward": "notify",
            "protocol": "http"
        }
    },
    "build": {
        "dockerfile": "Dockerfile"
    },
    "features": {
        "ghcr.io/devcontainers/features/node:2": {},
        "ghcr.io/thediveo/devcontainer-features/local-pkgsite:1": {
            "port": "6060"
        },
        "ghcr.io/thediveo/devcontainer-features/pinact:0": {},
        "ghcr.io/thediveo/devcontainer-features/go-mod-upgrade:1": {},
        "ghcr.io/thediveo/devcontainer-features/lazygit:0": {},
        "ghcr.io/thediveo/devcontainer-features/gocover:1": {
            "tags": "matchers",
            "root": true,
            "num-programs": "1",
            "race": true,
            "verbose": true,
            "html": true
        }
    },
    // IMPORTANT: no features declaring "init": true (go; the CLI ORs it, so
    // systemd wouldn't be PID 1) or starting daemons via "entrypoint"
    // (docker-in-docker; clashes with systemd's docker.service).
    "overrideCommand": false,
    "init": false,
    "privileged": true,
    "runArgs": [
        "--cgroupns=host", // needed for ./detector/containerd unit tests
        "--tmpfs=/run",
        "--tmpfs=/run/lock"
    ],
    "mounts": [
        "source=/sys/fs/cgroup,target=/sys/fs/cgroup,type=bind",
        {
            "source": "dind-var-lib-docker-${devcontainerId}",
            "target": "/var/lib/docker",
            "type": "volume"
        },
        {
            "source": "dind-var-lib-containerd-${devcontainerId}",
            "target": "/var/lib/containerd",
            "type": "volume"
        }
    ],
    "remoteEnv": {
        "GOPATH": "/home/vscode/go",
        "PATH": "/home/vscode/go/bin:/go/bin:/usr/local/go/bin:${containerEnv:PATH}"
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "golang.Go",
                "ms-azuretools.vscode-containers",
                "stkb.rewrap",
                "brunnerh.insert-unicode",
                "mhutchie.git-graph",
                "ms-vscode.makefile-tools"
            ]
        }
    }
}